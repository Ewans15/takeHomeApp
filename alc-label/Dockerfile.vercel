
# `Dockerfile.vercel` at the project root and builds it as a container-backed
# works the same as `docker compose up`.
FROM python:3.12-slim

# tesseract-ocr + tesseract-ocr-eng: the actual OCR engine + English language data
# libgl1 / libglib2.0-0: runtime libs opencv-python-headless needs even in headless mode
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PORT=8000
EXPOSE 8000

CMD gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 2 --threads 4 --timeout 60 app:app
